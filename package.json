{
  "name": "trae-account-manager",
  "version": "1.1.1",
  "description": "Traework Multi-Account Manager - Manage multiple Traework accounts, batch check-in for credits, and switch accounts easily",
  "author": "Trae Account Manager",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && tsc -p tsconfig.main.json && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "pack": "node scripts/build.js",
    "dist": "node scripts/build.js --dist",
    "generate-icon": "node scripts/generate-ico.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.trae.accountmanager",
    "productName": "Trae Account Manager",
    "copyright": "Copyright © 2026 Trae Account Manager",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "executableName": "Trae Account Manager",
      "artifactName": "Trae-Account-Manager-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trae Account Manager",
      "uninstallDisplayName": "Trae Account Manager"
    },
    "extraMetadata": {
      "author": "Trae Account Manager"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "write-file-atomic": "^5.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "lucide-react": "^0.436.0",
    "postcss": "^8.4.41",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resedit": "^3.0.2",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  }
}
